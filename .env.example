# Environment variables for Smart Dairy Farm Analytics (Production & Development)
APP_NAME=Smart Dairy Farm Analytics & Milk Yield Prediction
DEBUG=False
CORS_ORIGINS=["*"]
ENV=production

# Model settings (FastAPI backend looks for these under app/models/)
MODEL_DIR=app/models
MODEL_FILE=milk_yield_prediction_model.pkl

# MongoDB Atlas Database URI Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=smart_dairy
PREDICTIONS_COLLECTION=predictions
